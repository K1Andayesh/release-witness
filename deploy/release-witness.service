[Unit]
Description=Release Witness public competition demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=releasewitness
Group=releasewitness
WorkingDirectory=/srv/release-witness/current
Environment=NODE_ENV=production
Environment=HOME=/srv/release-witness
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=PUBLIC_BASE_URL=https://release-witness.139-99-135-89.sslip.io
Environment=PUBLIC_DEMO_MODE=true
Environment=BROWSER_CHANNEL=chromium
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/release-witness/shared/ms-playwright
Environment=NEBIUS_INFERENCE_APPROVED=false
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/release-witness/shared/artifacts
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target

