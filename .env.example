NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Set true only after verifying free credits or authorizing the call's cost.
NEBIUS_INFERENCE_APPROVED=false
MODEL_CALL_LIMIT=10
# Use chromium in the official Playwright container; local development defaults to installed Chrome.
BROWSER_CHANNEL=chrome
# Public deployments must set all three. Public mode excludes local-only manifests and model calls.
# HOST=0.0.0.0
# PUBLIC_BASE_URL=https://release-witness.example.com
# PUBLIC_DEMO_MODE=true
